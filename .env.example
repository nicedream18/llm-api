APP_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=waliapi
DB_USER=waliapi
DB_PASSWORD=<set-in-deployment>
SERVER_PORT=9900
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=<only-for-first-start-bootstrap>
ADMIN_TOKEN=<set-a-long-random-token>
ADMIN_SESSION_SECRET=<set-at-least-32-random-characters>
PROVIDER_TOKEN_KEY=<set-a-long-random-encryption-key>
MCP_TOKEN=
MCP_API_KEY_ACCESS=false
MODELS_REQUIRE_API_KEY=true
CORS_ALLOWED_ORIGINS=http://localhost:9900
GATEWAY_RETRY_TIMES=2
GATEWAY_RETRY_BACKOFF_MS=100
GATEWAY_REQUEST_TIMEOUT_SECONDS=300
GATEWAY_STREAM_TIMEOUT_SECONDS=300
KB_WORKER_COUNT=1
KB_TASK_LEASE_SECONDS=300
KB_TASK_MAX_ATTEMPTS=3
API_KEY_QUOTA_RESERVE=1024
SOFTWARE_ALLOW_INSTALL=false

# Optional Unix socket; leave unset for TCP connections.
# DB_UNIX_SOCKET=/path/to/mysql.sock
